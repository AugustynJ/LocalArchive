# LocalArchive – konfiguracja backendu (Flask).
# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# W chmurze (Cloud Run) te same zmienne ustawia deploy/service.yaml.tpl,
# a wartości tajne pochodzą z Secret Manager.

# --- Wymagane ---
# Baza PostgreSQL (schemat: db/schema.sql)
DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/localarchive
# Klucz podpisujący tokeny JWT – długi, losowy, np.: openssl rand -base64 48
JWT_SECRET_KEY=zmien-mnie-na-losowy-klucz
# Redis – lista dozwolonych tokenów sesji i tokeny resetu hasła
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Katalog na pliki zdjęć
UPLOAD_FOLDER=./uploads

# --- Opcjonalne ---
# Hasło i TLS dla Redis (Memorystore: AUTH + szyfrowanie w tranzycie)
REDIS_PASSWORD=
REDIS_SSL=false
# Ścieżka do certyfikatu CA serwera Redis (gdy REDIS_SSL=true)
REDIS_CA_CERT=
# true za HTTPS – ciasteczka sesji z flagą Secure (lokalnie po HTTP: false)
JWT_COOKIE_SECURE=false
# Lista originów (po przecinku) dla CORS; puste = CORS wyłączony (frontend i API pod jednym adresem)
CORS_ORIGINS=
# Poziom logowania: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Tryb debug serwera deweloperskiego (python app.py) – nigdy w produkcji
FLASK_DEBUG=false

# --- Reset hasła przez e-mail (obecnie wyłączony w interfejsie) ---
# Adres frontendu używany w linku resetującym
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adres nadawcy (domyślnie SMTP_USER)
SMTP_FROM=
