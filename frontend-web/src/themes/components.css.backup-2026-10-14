/* CSS Variables for Theming */
:root[data-theme="light"] {
  --primary-color: #2980b9;
  --primary-hover: #3498db;
  --secondary-color: #34495e;
  --background-color: #ffffff;
  --surface-color: #f8f9fa;
  --text-color: #2c3e50;
  --text-secondary: #7f8c8d;
  --border-color: #ddd;
  --shadow-color: rgba(0, 0, 0, 0.1);
  --error-color: #e74c3c;
  --success-color: #27ae60;
  --warning-color: #f39c12;
  --input-bg: #ffffff;
  --button-gradient: linear-gradient(145deg, #3498db, #2980b9);
}

:root[data-theme="dark"] {
  --primary-color: #3498db;
  --primary-hover: #5dade2;
  --secondary-color: #34495e;
  --background-color: #1a1a1a;
  --surface-color: #2c2c2c;
  --text-color: #ecf0f1;
  --text-secondary: #bdc3c7;
  --border-color: #555;
  --shadow-color: rgba(0, 0, 0, 0.3);
  --error-color: #e74c3c;
  --success-color: #27ae60;
  --warning-color: #f39c12;
  --input-bg: #34495e;
  --button-gradient: linear-gradient(145deg, #5dade2, #3498db);
}

/* Global Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
    'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
    sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  background-color: var(--background-color);
  color: var(--text-color);
  transition: background-color 0.3s ease, color 0.3s ease;
  line-height: 1.6;
}

/* Layout Components */
.app-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  min-height: 100vh;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.content-wrapper {
  background-color: var(--surface-color);
  border-radius: 12px;
  padding: 40px;
  box-shadow: 0 8px 24px var(--shadow-color);
  width: 100%;
  max-width: 500px;
  transition: all 0.3s ease;
}

.content-wrapper.wide {
  max-width: 800px;
}

/* Header with Navigation */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: var(--surface-color);
  border-bottom: 1px solid var(--border-color);
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.back-button {
  background: var(--button-gradient);
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 20px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.back-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
}

.theme-switcher {
  background: var(--button-gradient);
  color: white;
  border: none;
  padding: 8px 12px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 16px;
  transition: all 0.3s ease;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.theme-switcher:hover {
  transform: scale(1.1);
  box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
}

/* Adjust main content to account for header */
.page-container.with-header {
  padding-top: 100px;
}

/* Typography */
h1 {
  color: var(--text-color);
  margin-bottom: 30px;
  text-align: center;
  font-size: 2.5rem;
  font-weight: 300;
  letter-spacing: -1px;
}

h2 {
  color: var(--text-color);
  margin-bottom: 20px;
  font-size: 1.5rem;
  font-weight: 500;
}

p {
  margin-bottom: 15px;
  color: var(--text-secondary);
}

/* Form Styles */
.form-container {
  width: 100%;
}

.form-group {
  margin-bottom: 20px;
}

.input-field {
  width: 100%;
  padding: 15px;
  border: 2px solid var(--border-color);
  border-radius: 8px;
  font-size: 16px;
  background-color: var(--input-bg);
  color: var(--text-color);
  transition: all 0.3s ease;
}

.input-field:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
}

.input-field::placeholder {
  color: var(--text-secondary);
}

/* Password field with visibility toggle */
.password-wrapper {
  position: relative;
}

.password-wrapper .input-field {
  padding-right: 52px;
}

.password-wrapper .input-field::-ms-reveal {
  display: none;
}

.password-toggle {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  padding: 6px;
  background: none;
  border: none;
  border-radius: 6px;
  color: var(--text-secondary);
  cursor: pointer;
  transition: color 0.2s ease;
}

.password-toggle:hover,
.password-toggle:focus-visible {
  color: var(--primary-color);
  outline: none;
}

.success-message {
  color: var(--success-color);
  background-color: rgba(39, 174, 96, 0.1);
  border: 1px solid var(--success-color);
  border-radius: 8px;
  padding: 12px 15px;
  margin-bottom: 20px;
  text-align: center;
  font-weight: 500;
}

.error-banner {
  color: var(--error-color);
  background-color: rgba(231, 76, 60, 0.1);
  border: 1px solid var(--error-color);
  border-radius: 8px;
  padding: 12px 15px;
  margin-bottom: 20px;
  text-align: center;
  font-weight: 500;
}

.error-message {
  color: var(--error-color);
  font-size: 14px;
  margin-top: 5px;
  display: flex;
  align-items: center;
  gap: 5px;
}

/* Button Styles */
.btn {
  padding: 15px 25px;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 120px;
}

.btn-primary {
  background: var(--button-gradient);
  color: white;
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
}

.btn-secondary {
  background-color: var(--text-secondary);
  color: white;
}

.btn-secondary:hover {
  background-color: var(--secondary-color);
  transform: translateY(-2px);
}

.btn-link {
  background: none;
  border: none;
  color: var(--primary-color);
  cursor: pointer;
  padding: 8px 0;
  text-decoration: underline;
  font-size: 14px;
}

.btn-link:hover {
  color: var(--primary-hover);
}

.button-group {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  justify-content: center;
}

.button-group.align-left {
  justify-content: flex-start;
}

/* User Info Styles */
.user-info {
  background-color: var(--background-color);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 25px;
  margin-bottom: 30px;
}

.user-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-color);
}

.user-info-item:last-child {
  border-bottom: none;
}

.user-info-label {
  font-weight: 600;
  color: var(--text-color);
}

.user-info-value {
  color: var(--text-secondary);
}

.status-badge {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.status-active {
  background-color: rgba(39, 174, 96, 0.1);
  color: var(--success-color);
  border: 1px solid var(--success-color);
}

.status-blocked {
  background-color: rgba(231, 76, 60, 0.1);
  color: var(--error-color);
  border: 1px solid var(--error-color);
}

/* Navigation Section */
.navigation-section {
  margin: 30px 0;
}

.navigation-section h2 {
  margin-bottom: 20px;
  color: var(--text-color);
  font-size: 1.3rem;
}

/* Home Page Specific */
.home-container {
  text-align: center;
  max-width: 600px;
}

.home-title {
  background: var(--button-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-size: 3rem;
  margin-bottom: 30px;
  font-weight: 600;
}

.home-link {
  background: var(--button-gradient);
  color: white;
  text-decoration: none;
  padding: 15px 30px;
  border-radius: 25px;
  font-size: 18px;
  font-weight: 500;
  transition: all 0.3s ease;
  display: inline-block;
}

.home-link:hover {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(52, 152, 219, 0.4);
}

/* Loading and Error States */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 200px;
  color: var(--text-secondary);
  font-size: 18px;
}

.error-container {
  text-align: center;
  color: var(--error-color);
  padding: 20px;
}

/* Responsive Design */
@media (max-width: 768px) {
  .content-wrapper {
    padding: 30px 20px;
    margin: 10px;
    border-radius: 8px;
  }
  
  .header {
    padding: 10px 15px;
  }
  
  .page-container.with-header {
    padding-top: 80px;
  }
  
  h1 {
    font-size: 2rem;
  }
  
  .home-title {
    font-size: 2.5rem;
  }
  
  .button-group {
    flex-direction: column;
    align-items: stretch;
  }
  
  .btn {
    width: 100%;
    margin-bottom: 10px;
  }
  
  .user-info-item {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
}

@media (max-width: 480px) {
  .page-container {
    padding: 10px;
  }
  
  .content-wrapper {
    padding: 20px 15px;
  }
  
  h1 {
    font-size: 1.8rem;
  }
  
  .home-title {
    font-size: 2rem;
  }
  
  .input-field, .btn {
    font-size: 16px; /* Prevent zoom on iOS */
  }
}

/* Animation Classes */
.fade-in {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Focus Management for Accessibility */
.btn:focus,
.input-field:focus,
.back-button:focus,
.theme-switcher:focus {
  outline: none;
  box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.3);
}

/* Print Styles */
@media print {
  .header,
  .theme-switcher,
  .back-button {
    display: none;
  }
  
  .page-container {
    padding: 0;
  }
  
  .content-wrapper {
    box-shadow: none;
    border: 1px solid #ccc;
  }
}